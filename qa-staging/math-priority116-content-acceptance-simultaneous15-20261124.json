      "question": {
        "sourceId": "LUX-MATH-Y9-SIMULTANEOUS-018",
        "revisionId": "LUX-MATH-Y9-SIMULTANEOUS-018-PRIORITY-CONTENT-REVIEW-20261124",
        "replacesOriginalRevisionId": "LUX-MATH-Y9-SIMULTANEOUS-018-REVIEW-2",
        "topicId": "math-y9-simultaneous-equations",
        "provisionalConceptFamily": "weighted-mixture",
        "stem": "A technician mixes 8% and 20% salt solutions by mass to make 750 g of 16% solution. She then removes 150 g of the well-mixed solution and replaces it with 150 g of a new mixture made from the same two original solutions. Assume no salt or solution is lost except for the stated removal. The final concentration is exactly 15.2%. How many grams of the 20% solution were used in total across both mixing stages?",
        "options": [
          {
            "id": "A",
            "latex": "500",
            "errorPath": "Ignore the replacement stage."
          },
          {
            "id": "B",
            "latex": "50",
            "errorPath": "Report only the high-concentration solution used in the replacement."
          },
          {
            "id": "C",
            "latex": "600",
            "errorPath": "Assume the replacement has the same concentration as the initial mixture."
          },
          {
            "id": "D",
            "latex": "550"
          },
          {
            "id": "E",
            "latex": "650",
            "errorPath": "Assume all replacement mass is 20% solution."
          },
          {
            "id": "F",
            "latex": "114",
            "errorPath": "Report the final salt mass rather than the total high-concentration solution."
          }
        ],
        "correctOptionId": "D",
        "correctAnswerLatex": "550",
        "workedSolutionSteps": [
          "First mix: 0.08(750−h)+0.20h=120, so h=500 g.",
          "Removing 150 g removes 24 g of salt. Final salt is 0.152×750=114 g, so the replacement contributes 18 g.",
          "Let H be the high-concentration mass in the 150 g replacement: 0.08(150−H)+0.20H=18 gives H=50. Total=550 g."
        ],
        "provisionalAOFocus": "Multi-condition reasoning candidate; independent Grade 7+ calibration pending",
