            "id": "F",
            "latex": "3",
            "errorPath": "Report increase in b."
          }
        ],
        "correctOptionId": "D",
        "correctAnswerLatex": "-6",
        "workedSolutionSteps": [
          "From 3a−b=3, b=3a−3. Substitute into original first equation:11a−9=24 gives a3,b6,c7.",
          "New first gives11a−9=35, so a4,b9,c1.",
          "Change=1−7=−6."
        ],
