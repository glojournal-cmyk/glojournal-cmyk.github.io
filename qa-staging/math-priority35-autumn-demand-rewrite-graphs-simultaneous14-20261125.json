        "topicId": "math-y9-simultaneous-equations",
        "stem": "Three real numbers satisfy $2a+3b=24$, $3a-b=3$ and $2b+c=19$. A new set of numbers satisfies the same second and third equations, but the first is changed to $2a+3b=35$. Find the change in c (new value minus original value).",
        "options": [
          {
            "id": "A",
            "latex": "6",
            "errorPath": "Reverse order of subtraction."
          },
          {
            "id": "B",
            "latex": "-3",
            "errorPath": "Forget coefficient2 in c=19−2b when computing change."
          },
          {
            "id": "C",
            "latex": "1",
            "errorPath": "Report new c."
          },
          {
            "id": "D",
            "latex": "-6"
          },
          {
            "id": "E",
            "latex": "7",
            "errorPath": "Report old c."
          },
