        "topicId": "math-y9-straight-line-graphs",
        "provisionalConceptFamily": "two-distance-constraint-roots",
        "stem": "A circle has centre (2,3) and passes through O=(0,0). A horizontal line $y=k$ intersects the circle at two distinct points A and B with integer x-coordinates and integer k. Find the sum of all possible positive integer k.",
        "options": [
          {
            "id": "A",
            "latex": "6",
            "errorPath": "Report only the greatest eligible positive k."
          },
          {
            "id": "B",
            "latex": "3",
            "errorPath": "Report the number of eligible positive k."
          },
          {
            "id": "C",
            "latex": "12"
          },
          {
            "id": "D",
            "latex": "15",
            "errorPath": "Include k=3 even though the intersections are not integral."
