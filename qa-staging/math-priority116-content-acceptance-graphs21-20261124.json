        "topicId": "math-y9-straight-line-graphs",
        "provisionalConceptFamily": "perpendicular-gradient-parameter",
        "stem": "The line through $A=(k,2k+1)$ and $B=(3,5)$ is perpendicular to $y=2x+7$. Find the exact area of the triangle whose vertices are O=(0,0), A and B.",
        "options": [
          {
            "id": "A",
            "latex": "\\frac{13}{5}"
          },
          {
            "id": "B",
            "latex": "\\frac{26}{5}",
            "errorPath": "Omit the triangle factor 1/2."
          },
          {
